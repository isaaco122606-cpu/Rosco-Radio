@@ -0,0 +1,68 @@
+from __future__ import annotations
+
+from datetime import datetime, timezone
+
+ACHIEVEMENTS = {
+    "baited": {
+        "title": "Baited",
+        "description": "Tried to use a CB radio with RR when no support will ever go live for it... hehe",
+    },
+    "vox_first": {
+        "title": "Transmitted through VOX for the first time",
+        "description": "Transmission is glory! Transmission is life! YOU SHALL TRANSMIT MORE!!",
+    },
+    "serial_ptt_first": {
+        "title": "Transmitted through serial-PTT for the first time",
+        "description": "Even I can't do that... how did you manage to do that? please tell me😭",
+    },
+    "utc_tts": {
+        "title": "Got a UTC announcement via the TTS decoder",
+        "description": "Honestly amazing. That thing can barely hear the Text of Ulysses read at 0.5x speed!",
+    },
+    "chocolate_complete": {
+        "title": "Watched the whole Chocolate Broadcast",
+        "description": "Torture.",
+    },
+    "rx_contact": {
+        "title": "Received an RX contact for the first time",
+        "description": "Less chance of being lonely!",
+    },
+    "cw_contact": {
+        "title": "Made a first contact with CW/Morse Code",
+        "description": ".. / -... . - / -.-- --- ..- / -.-. .- -. .----. - / . ...- . -. / .-. . .- -.. / - .... .. ... .-.-.- .-.-.- .-.-.-",
+    },
+    "ai_freakout": {
+        "title": "Forced RR AI to freak out",
+        "description": "Ah yes, the art of messing with a 4b params model.",
+    },
+}
+
+
+def ensure_store(cfg):
+    store = cfg.setdefault("achievements", {})
+    if not isinstance(store, dict):
+        store = {}
+        cfg["achievements"] = store
+    return store
+
+
+def unlock(cfg, key):
+    if key not in ACHIEVEMENTS:
+        return None
+    store = ensure_store(cfg)
+    if key in store:
+        return None
+    store[key] = datetime.now(timezone.utc).isoformat(timespec="seconds")
+    item = dict(ACHIEVEMENTS[key])
+    item["key"] = key
+    item["unlocked_at"] = store[key]
+    return item
+
+
+def is_unlocked(cfg, key):
+    return key in ensure_store(cfg)
+
+
+def count_unlocked(cfg):
+    store = ensure_store(cfg)
+    return sum(1 for key in ACHIEVEMENTS if key in store)
